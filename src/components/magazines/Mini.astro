---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Minigallery from "./Minigallery.astro";

import stickers from "@/assets/magazines/mini/stickers3.png";

import Sep from "@/assets/sep.svg";
import ArrowRight from "@/assets/icons/lu-arrow-right.svg";

const entry = await getEntry("magazines", "mini");
if (!entry) {
  throw new Error("mini magazine entry not found");
}

const { logo, pages, pdf } = entry.data;
---

<div
  id="mag-mini"
  class="relative isolate overflow-x-clip bg-mini text-black"
>
  <Sep
    class="absolute inset-x-0 -top-[0.78125vw] h-auto w-full text-mini"
  />

  <div class="p-12 sm:p-16">
    <div class="flex justify-between text-xl text-current/75">
      <p class="header-left opacity-0">#2</p>
      <p class="header-right opacity-0">&mdash; mini</p>
    </div>
    <p class="strapline mt-4 text-3xl leading-snug text-pretty opacity-0">
      A mini 12-page magazine, to serve as an introduction to Hack Club!
    </p>
    <div class="cta mt-6 flex flex-wrap items-center gap-3 opacity-0">
      <a
        href="/mini"
        target="_blank"
        class="flex h-12 w-fit items-center rounded-3xl bg-[#23AEF8] px-5 font-jua text-xl text-white outline-offset-2 outline-white transition corner-squircle hover:scale-105 hover:bg-[#0578CA] focus:scale-105 focus:bg-[#0578CA] focus:outline-2 active:scale-100"
      >
        learn more
        <span
          class="ml-2 grid size-5 place-items-center rounded-full bg-white text-sm text-[#23AEF8] uppercase"
        >
          <ArrowRight class="size-3" stroke-width={4} />
        </span>
      </a>
      <a
        href={pdf}
        target="_blank"
        class="flex h-12 w-fit items-center rounded-3xl bg-[#23AEF8] px-5 font-jua text-xl text-white outline-offset-2 outline-white transition corner-squircle hover:scale-105 hover:bg-[#0578CA] focus:scale-105 focus:bg-[#0578CA] focus:outline-2 active:scale-100"
      >
        view mini magazine
        <span
          class="ml-2 grid size-5 place-items-center rounded-full bg-white text-sm text-[#23AEF8] uppercase"
        >
          <ArrowRight class="size-3" stroke-width={4} />
        </span>
      </a>
      <p class="text-current/60">(5MB)</p>
    </div>
  </div>
  <div class="gallery relative opacity-0">
    <Minigallery pages={pages} />
    <Image
      src={logo}
      alt=""
      role="presentation"
      class="pointer-events-none absolute top-1/2 left-1/2 h-45 w-auto max-w-[90%] -translate-x-1/2 -translate-y-1/2 rotate-2 object-scale-down"
      widths={[logo.width / 4, logo.width / 2, logo.width]}
      sizes="(max-width: 1024px) 496px, 48.4375vw"
    />
  </div>
  <div class="relative -z-10 mt-4 overflow-clip">
    <Image
      src={stickers}
      alt=""
      role="presentation"
      class="stickers h-auto w-full opacity-0 drop-shadow-lg"
      widths={[stickers.width / 4, stickers.width / 2, stickers.width]}
      sizes="100vw"
    />
  </div>
</div>

<script>
  import { createTimeline, onScroll } from "animejs";

  createTimeline({
    autoplay: onScroll({
      target: "#mag-mini",
      enter: "center",
      leave: "center",
    }),
    defaults: {
      ease: "outExpo",
    },
  })
    .add("#mag-mini .header-left", {
      opacity: [0, 1],
      ease: "linear",
      duration: 400,
    })
    .add(
      "#mag-mini .header-right",
      {
        opacity: [0, 1],
        ease: "linear",
        duration: 400,
      },
      "<<+=100",
    )
    .add(
      "#mag-mini .strapline",
      {
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800,
      },
      "<<+=100",
    )
    .add(
      "#mag-mini .cta",
      {
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800,
      },
      "<<+=100",
    )
    .add(
      "#mag-mini .gallery",
      {
        opacity: [0, 1],
        translateY: [20, 0],
        duration: 800,
      },
      "<<+=500",
    )
    .add(
      "#mag-mini .stickers",
      {
        opacity: [0, 1],
        translateY: [40, 0],
        duration: 800,
      },
      "<<+=100",
    );
</script>
